# Базовый URL для аутентификации
NEXTAUTH_URL=http://localhost:3000

# Секретный ключ (можете придумать любой длинный пароль)
NEXTAUTH_SECRET=dachago-super-secret-key-2026-v1

# Настройки Google (получить в console.cloud.google.com)
GOOGLE_CLIENT_ID=ваш-google-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ваш-google-секрет

# Настройки Apple (получить в developer.apple.com)
APPLE_ID=ваш-apple-id
APPLE_SECRET=ваш-apple-секрет-токен
